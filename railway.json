{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "cargo build --release --locked"
    },
    "deploy": {
        "startCommand": "./target/release/english-word-bot",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE"
    }
}
